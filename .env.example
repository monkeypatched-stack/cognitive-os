# =============================================================================
# monkeypatched — Unified Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# All services, agents, and the CLI read from this single file.
#
#   cp .env.example .env
#   source .env          # or use python-dotenv / direnv
# =============================================================================


# =============================================================================
# ── CLI ───────────────────────────────────────────────────────────────────────
# =============================================================================

# MonkeyBrain API (cognitive kernel) — use Kong gateway in dev/prod
MONKEYBRAIN_URL="http://localhost:8000"
KONG_PROXY_URL="http://localhost:8000"
COGCTL_API_URL="http://localhost:8000/api/v1/agentos"

# Auth service (id / acl commands) — route through Kong when possible
AUTH_SERVICE_URL="http://localhost:8000"

# NATS message queue (mq commands)
NATS_URL="nats://localhost:4222"


# =============================================================================
# ── Runtime identity ─────────────────────────────────────────────────────────
# =============================================================================

AGENTOS_USER_EMAIL=""
AGENTOS_MASTER_KEY=""
ENVIRONMENT="development"           # development | staging | production

# Authn/authz enforcement. ON unless explicitly disabled. Set to "false" only
# for local development: doing so lets any decodable token grant every
# permission, and accepts a bare X-User-ID header as authentication.
AGENTOS_AUTH_REQUIRED="true"


# =============================================================================
# ── LLM providers ────────────────────────────────────────────────────────────
# =============================================================================

# Active model backend  (claude | openai | openrouter | ollama | azure | google | qwen)
MODEL_BACKEND="ollama"

# src/llm/llm_provider.py's own separate provider abstraction (claude | openrouter | ollama)
LLM_PROVIDER="ollama"

# Anthropic (Claude) — primary
ANTHROPIC_API_KEY=""
ANTHROPIC_API_URL="https://api.anthropic.com/v1"

# OpenAI
OPENAI_API_KEY=""
OPENAI_API_URL="https://api.openai.com/v1"

# OpenRouter (multi-model proxy)
OPENROUTER_API_KEY=""
OPENROUTER_API_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Google Gemini / PaLM
GOOGLE_API_KEY=""
GOOGLE_CLOUD_PROJECT=""

# Azure OpenAI
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_ENDPOINT=""
AZURE_SUBSCRIPTION_ID=""

# Ollama (local inference)
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_API_URL="http://localhost:11434"
OLLAMA_MODEL="gemma3:latest"
OLLAMA_DEFAULT_MODEL="gemma3:latest"
OLLAMA_NUM_PARALLEL="4"
OLLAMA_MAX_LOADED_MODELS="2"

# Specification Discovery (autonomous spec inference)
SPEC_DISCOVERY_PROVIDER="auto"         # auto | ollama | claude

# CodeGenAgent (src/sittingface/codegen_agent.py) provider order — the named
# one goes first, the other two remain fallbacks behind it.
CODEGEN_PRIMARY="ollama"               # ollama | claude | openrouter

# Qwen / DashScope
DASHSCOPE_API_KEY=""
QWEN_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"


# =============================================================================
# ── Databases  (store sub-app) ───────────────────────────────────────────────
# =============================================================================

# MongoDB
MONGODB_URL="mongodb://localhost:27017"
DB_NAME="agentos"
MONGO_DB="agentos"

# Redis
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_DB="0"

# Neo4j
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD=""

# InfluxDB (metrics / time-series)
INFLUXDB_URL="http://localhost:8181"
INFLUXDB_TOKEN=""
INFLUXDB_ORG="agentos"

# Elasticsearch
ELASTICSEARCH_URL="http://localhost:9200"

# mem0 (semantic memory)
MEM0_URL="http://localhost:8080"


# =============================================================================
# ── Microservice URLs ──────────────────────────────────────────────────────────
# =============================================================================

# Auth service (required — only manufacturing service enabled)
AUTH_SERVICE_BASE_URL="http://localhost:8010"

# Manufacturing domain services (disabled — knowledge-only, not needed for SOE)
# ASSETS_SERVICE_URL="http://localhost:8011"
# CUSTOMERS_SERVICE_URL="http://localhost:8012"
# EVENTS_SERVICE_URL="http://localhost:8013"
# FACILITIES_SERVICE_URL="http://localhost:8014"
# FLOOR_LAYOUT_SERVICE_URL="http://localhost:8015"
# INVENTORY_SERVICE_URL="http://localhost:8016"
# IOT_SERVICE_URL="http://localhost:8017"
# ORDERS_SERVICE_URL="http://localhost:8018"
# PM_SERVICE_URL="http://localhost:8019"
# PROCUREMENT_SERVICE_URL="http://localhost:8020"
# PRODUCTS_SERVICE_URL="http://localhost:8021"
# SHIPPING_SERVICE_URL="http://localhost:8022"
# SHIFTS_SERVICE_URL="http://localhost:8023"
# SUPPLIERS_SERVICE_URL="http://localhost:8024"
# TAXONOMY_SERVICE_URL="http://localhost:8025"
# PROCESS_DEFINITION_SERVICE_URL="http://localhost:8000"
# WORKORDERS_SERVICE_URL="http://localhost:8027"
# CHANGEOVER_SERVICE_URL="http://localhost:8028"
# DOCUMENTS_SERVICE_URL="http://localhost:8029"
# FILE_SERVICE_URL="http://localhost:8030"
# MODULE_CONTROL_SERVICE_URL="http://localhost:8032"


# =============================================================================
# ── ETASS pipeline (init sub-app) ────────────────────────────────────────────
# =============================================================================

# Source control
GITHUB_TOKEN=""
GITHUB_OWNER=""
GITHUB_REPO=""

# MonkeyBrain repo paths (absolute — set to your checkout location)
MONKEYBRAIN_REPO="/path/to/monkeypatched"
MONKEYBRAIN_SPEC_REPO=""
MONKEYBRAIN_GEN_DIR="/path/to/generated/monkeypatched"
MONKEYBRAIN_EVIDENCE_DIR="/path/to/monkeypatched/.operational_evidence"
MONKEYBRAIN_CHARTS_DIR="/path/to/monkeypatched/somatic/charts"
MONKEYPATCHED_REPO_ROOT="/path/to/monkeypatched"

# Human-in-the-loop (n8n workflow approvals) — REQUIRED
N8N_BASE_URL="http://localhost:5678"
N8N_WEBHOOK_URL="http://localhost:5678/webhook"
N8N_WEBHOOK_URL_HUMAN_REVIEW="http://localhost:5678/webhook/human-review"

# OpenClaw integration — leave blank to use the local CLI/gateway (the
# default). Only set this to a *separate*, headless OpenClaw REST API server
# if one is actually running — the local gateway's own address (e.g.
# http://localhost:18789) serves its web UI at /agents, not JSON, and setting
# it here makes every REST-mode discovery check misread OpenClaw as unreachable.
OPENCLAW_API_URL=""

# NANDA agent registry
NANDA_REGISTRY_URL=""
NANDA_API_KEY=""


# =============================================================================
# ── SittingFace chart registry  (pkg sub-app) ────────────────────────────────
# =============================================================================

SITTINGFACE_URL="http://localhost:8500"
SITTINGFACE_GENERATED_DIR=""
SITTINGFACE_DISABLED="0"           # set to "1" to skip chart publishing


# =============================================================================
# ── Observability ────────────────────────────────────────────────────────────
# =============================================================================

# Log
LOG_LEVEL="INFO"                   # DEBUG | INFO | WARNING | ERROR
LOG_BACKEND="console"              # console | elk | file
LOG_MODE=""
LOG_DIR="logs"
LOG_TRACE_DIR="logs/traces"

# Trace
TRACE_BACKEND="elk"                # elk | jaeger | console
TRACE_MODE=""
TRACE_DIR=""

# ELK / Logstash
ELK_HOST="localhost"
LOGSTASH_HOST="localhost"

# Sentry
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
SENTRY_RELEASE=""
SENTRY_SEND_DEFAULT_PII="false"


# =============================================================================
# ── File / Document services ─────────────────────────────────────────────────
# =============================================================================

FILE_UPLOAD_DIR="uploads/files"
DOCUMENT_UPLOAD_DIR="uploads/documents"
DOCUMENT_CHUNK_SIZE="1400"
DOCUMENT_CHUNK_OVERLAP="180"
DOCUMENT_EMBEDDING_TEXT_MAX_CHARS="20000"
DOCUMENT_EMBEDDING_MAX_BYTES=""

# CAD conversion tools (optional — install LibreCAD / ezdxf)
DWG_TO_DXF_COMMAND=""
DWG_TO_SVG_COMMAND=""
CAD_TO_SVG_COMMAND=""


# =============================================================================
# ── Cloud storage  (AWS S3) ──────────────────────────────────────────────────
# =============================================================================

AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_DEFAULT_REGION="us-east-1"
AWS_S3_BUCKET=""
AWS_S3_BACKUP_BUCKET=""
AWS_S3_BACKUP_PREFIX="backups/"
S3_BUCKET=""
S3_DOCUMENT_BUCKET=""
S3_DOCUMENT_PREFIX="documents"
S3_BACKUP_BUCKET=""
S3_ENDPOINT_URL=""
S3_PUBLIC_BASE_URL=""


# =============================================================================
# ── Notifications ────────────────────────────────────────────────────────────
# =============================================================================

# Slack
SLACK_WEBHOOK_URL=""

# Email (SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_PASSWORD=""


# =============================================================================
# ── WebSocket bridge ─────────────────────────────────────────────────────────
# =============================================================================

WEBSOCKET_URL=""
WEBSOCKET_BRIDGE_URI="ws://websocket-server:6789"
WEBSOCKET_TIMEOUT="10"
WEBSOCKET_EXPECT_JSON="false"
FORWARD_URL=""


# =============================================================================
# ── mTLS / Zero-Trust agent mesh ─────────────────────────────────────────────
# =============================================================================

# Set to "true" to activate MTLSMiddleware (default: disabled — zero impact)
MTLS_ENABLED="false"

# Path to PEM CA cert used to validate client certs forwarded by TLS terminator.
# Leave empty to trust the terminator unconditionally (still requires a valid cert header).
MTLS_CA_CERT_PATH=""

# nginx config snippet (reference — not a env var):
#   ssl_verify_client on;
#   proxy_set_header X-Client-Cert $ssl_client_escaped_cert;

# SPIFFE/SPIRE workload identity (kernel/workload_identity.py). The proxy
# terminating mTLS above (nginx/Envoy) is exactly where a SPIRE-issued
# X.509-SVID belongs for real mutual TLS -- see
# docs/SPIFFE_SPIRE_IDENTITY.md. These three configure the SEPARATE,
# lower-level Workload API connection kernel code itself uses to fetch
# its OWN identity (e.g. to bind agent-to-agent NATS/in-process
# communication to a verified principal, not just terminate a client TLS
# connection).

# Path to the SPIRE Agent's Workload API Unix domain socket. Empty
# (default) means no real SPIRE connection is attempted --
# WorkloadIdentityProvider.get_current_identity() returns None, and every
# caller falls back to existing non-SPIFFE evidence (never silently to a
# self-asserted identity).
SPIFFE_ENDPOINT_SOCKET=""

# This deployment's trust domain -- MUST differ between dev and
# production (Phase 5); never leave a production value here by copying
# this file verbatim.
SPIFFE_TRUST_DOMAIN="cognitiveos-dev.local"

# LOCAL DEV ONLY: a static SPIFFE URI to use when no real SPIRE Agent
# socket is reachable. Guarded at the code level
# (packages/cerebellum/.../spire_client.py::fetch_svid) to refuse outright
# under COGNITIVEOS_PRODUCTION_MODE or without COGNITIVEOS_ALLOW_INSECURE_
# DEV_MODE explicitly set -- never valid in production regardless of this
# value.
SPIFFE_ID=""

# Opt-in enforcement: refuse agent-to-agent communication outright when no
# verified SPIFFE identity is available, instead of falling back to the
# existing service-name evidence. Always true under
# COGNITIVEOS_PRODUCTION_MODE regardless of this setting (Non-negotiable
# rule 12) -- set explicitly here only to also enforce it in a non-
# production environment that has real SPIRE deployed.
COGNITIVEOS_REQUIRE_SPIFFE_AGENT_IDENTITY="false"


# =============================================================================
# ── Keycloak (optional SSO) ──────────────────────────────────────────────────
# =============================================================================

KEYCLOAK_INTERNAL_URL="http://keycloak:8080"
KEYCLOAK_ISSUER=""
KEYCLOAK_AUDIENCE=""
KC_CLIENT_ID=""
KC_CLIENT_SECRET=""


# =============================================================================
# ── Service tuning ───────────────────────────────────────────────────────────
# =============================================================================

CORS_ORIGINS="http://localhost:3000"
VERIFY_SSL="true"
SQL_ECHO="false"
APP_NAME="MonkeyBrain"
APP_URL="http://localhost:8031"

# ── Dev-mode LLM bridge ──────────────────────────────────────────────────────
# Route all planner/solver LLM calls to an external answerer via a file queue
# instead of Ollama/Claude — no API keys or local model needed. Dev/offline only.
LLM_DEV_BRIDGE=0
LLM_BRIDGE_DIR=/tmp/mb-llm-bridge
LLM_BRIDGE_TIMEOUT=600

# ── LLM response cache ───────────────────────────────────────────────────────
# Content-addressed (exact sha256(model+system+prompt) match) cache for
# planner/solver LLM calls. Collapses repeated prompts (same goal re-asked,
# plan issued for execute+simulate, compiler candidate prompts) to one call.
# File-backed, survives restarts. Wired into BOTH the ETASS/broca agents
# (packages/broca/broca/agents/_llm_cache.py) AND the core cognitive
# pipeline's own planner (kernel/pipeline/llm_plan_cache.py, used by
# llm_planner.py — write-on-success-only, so it never replays a malformed-
# JSON response into that planner's own retry loop).
LLM_RESPONSE_CACHE=0
LLM_CACHE_DIR=/tmp/mb-llm-cache
LLM_CACHE_MAX=1024

# ── Semantic plan cache (Moss) ────────────────────────────────────────────────
# Optional, separate from the exact-match cache above: kernel/pipeline/
# planning/moss_plan_cache.py catches a goal re-asked with DIFFERENT
# phrasing (or against slightly different but equivalent facts), which the
# exact-match cache always misses since its prompt text differs. Backed by
# Moss (docs.usemoss.dev) embedding similarity search — a genuinely
# separate index (cognitiveos-plan-cache) from kernel/edge/moss_retrieval.py's
# own knowledge-retrieval use of Moss. Enabled automatically once BOTH vars
# below are set (no separate on/off flag, same convention as
# moss_retrieval.py) — leave blank to disable entirely.
MOSS_PROJECT_ID=""
MOSS_PROJECT_KEY=""

# ── Global world model (SparseTransitionTensor) ──────────────────────────────
# When "true", each completed /execute run folds its agent→agent transitions into
# the per-tenant world tensor (observe_execution), building a global model over
# time. The write is defensive and tenant-isolated — it never affects a run's
# result — and is a no-op when unset. Production (deploy/k8s/configmap.yaml)
# enables this. MB_WORLD_TENSOR_PATH persists the world across restarts (parent
# dir auto-created; missing file starts empty).
MB_WORLD_TENSOR=true
MB_WORLD_TENSOR_PATH=.data/world_tensor.json

# ── RunStore backend (multi-worker) ──────────────────────────────────────────
# RunStore holds compiled runs (IntentIR + target + execution/simulation graphs)
# keyed by run_id. With >1 worker, /plan, /execute, /simulate and /learn may each
# land on a DIFFERENT worker, so a process-local store means /learn can't see the
# graphs the others produced. "auto" (default) uses a SHARED Redis store when
# REDIS_URL is reachable, else falls back to process-local memory; "redis" forces
# it (logs loudly if unreachable); "memory" forces process-local even with Redis up.
# Single-worker dev is fine on "memory"/"auto"-without-Redis.
RUN_STORE_BACKEND=auto
# TTL for Redis-stored runs (seconds). Working set is small and short-lived; the
# durable graph copy lives in PlanStore, so an expired run 404s on /replay.
RUN_STORE_TTL_SECONDS=86400
