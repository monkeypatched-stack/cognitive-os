<?xml version="1.0"?>
<sdf version="1.9">
  <model name="house_alpha">
    <!-- Static: no physics/gravity interaction beyond being a solid,
         collidable box -- this is a target structure for the crash-test
         demo, not a simulated building with interior physics. -->
    <static>true</static>
    <link name="body">
      <!-- Origin at ground level; box extends upward. A simple gable-less
           box is deliberately visually distinct (flat red walls, white
           roof slab) so LoFTR has real texture/geometry to match a
           reference photo against, not a featureless cube. -->
      <collision name="collision">
        <geometry>
          <box>
            <size>6 5 3</size>
          </box>
        </geometry>
      </collision>
      <visual name="walls">
        <pose>0 0 1.5 0 0 0</pose>
        <geometry>
          <box>
            <size>6 5 3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.65 0.15 0.1 1</ambient>
          <diffuse>0.65 0.15 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="roof">
        <pose>0 0 3.15 0 0 0</pose>
        <geometry>
          <box>
            <size>6.4 5.4 0.3</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.88 1</ambient>
          <diffuse>0.9 0.9 0.88 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
