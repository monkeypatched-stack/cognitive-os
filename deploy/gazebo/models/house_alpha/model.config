<?xml version="1.0"?>
<model>
  <name>house_alpha</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    Minimal static structure for the CognitiveOS simulator-only crash-test
    demo (kernel/domains/robot.py::CrashTestCapability). A single visually
    distinct box, spawned into the shared Gazebo world by
    deploy/k8s/gazebo-shared-deployment.yaml's world-setup container so
    LoFTR (kernel/edge/loftr_landmarks.py) has a real, identifiable
    "house_alpha" structure to match a reference photo against. Purely
    decorative/static -- no physics behavior beyond being a solid,
    collidable box; not a full building model.
  </description>
</model>
