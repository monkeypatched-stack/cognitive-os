FROM python:3.12-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    AGENTOS_AUTH_REQUIRED=false \
    PYTHONPATH=/app:/app/domains/manufacturing/knowledge:/app/sdk/python:/app/packages

WORKDIR /app

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        curl \
        kubectl \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

COPY pyproject.toml uv.lock .
RUN uv export --frozen --no-dev --no-hashes --no-emit-project -o requirements.lock.txt && \
    uv pip install --system -r requirements.lock.txt

COPY src/ ./src/
COPY services/ ./services/
COPY domains/ ./domains/
COPY packages/ ./packages/
COPY sdk/ ./sdk/
COPY monkeypatched_sdk/ ./monkeypatched_sdk/
# KubernetesProvisioner (kernel/society/kubernetes_provisioner.py) reads
# deploy/k8s/actor-deployment.yaml at runtime to render+apply a new
# actor's dedicated Pod -- confirmed live this was missing entirely from
# the shipped image (every provisioning attempt failed with "could not
# read template ... No such file or directory"), silently leaving every
# actor UNSCHEDULABLE forever regardless of KUBERNETES_PROVISIONING_ENABLED.
COPY deploy/k8s/ ./deploy/k8s/

EXPOSE 8031

CMD ["uvicorn", "src.monkey_brain.api.main:app", "--host", "0.0.0.0", "--port", "8031"]
